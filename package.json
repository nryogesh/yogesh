{
  "name": "ai-tutor-local-dev",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend ai",
    "backend ai"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm run dev --workspace=dsa-ai -- --host 0.0.0.0\" \"npm run dev --workspace=mentor-ai-backend\"",
    "dev:frontend": "npm run dev --workspace=dsa-ai -- --host 0.0.0.0",
    "dev:backend": "npm run dev --workspace=mentor-ai-backend",
    "worker": "npm run worker --workspace=mentor-ai-backend",
    "build": "npm run build --workspace=dsa-ai",
    "start": "npm run build && npm run start --workspace=mentor-ai-backend",
    "test": "npm test --workspace=dsa-ai && npm test --workspace=mentor-ai-backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
