{
  "name": "ai-tutor-local-dev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend ai",
    "backend ai"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build:frontend": "npm run build --workspace=dsa-ai",
    "build": "npm run build --workspace=dsa-ai",
    "lint": "npm run lint --workspace=dsa-ai",
    "dev": "npm run build && node server.js",
    "start": "node server.js",
    "dev:frontend": "npm run dev --workspace=dsa-ai -- --host 0.0.0.0",
    "dev:backend": "npm run dev --workspace=mentor-ai-backend",
    "worker": "npm run worker --workspace=mentor-ai-backend",
    "test": "npm test --workspace=dsa-ai && npm test --workspace=mentor-ai-backend"
  }
}
